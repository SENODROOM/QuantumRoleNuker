# ─────────────────────────────────────────────
#  Discord Bot
# ─────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_discord_guild_id

# ─────────────────────────────────────────────
#  Activity Bot Database (database.js)
#  Base URI — bot uses test.members for all member data (roles, status, warnings)
#  Also stores: communication, leave logs
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.j4zqqkl.mongodb.net/
# Direct shard hosts — required when SRV DNS is blocked on your network
# Optional fallback — get current shard hosts from Atlas → Connect → Drivers
# Hostnames change when Atlas recreates the cluster (e.g. ac-1is8sla-shard-00-00.j4zqqkl.mongodb.net)
MONGODB_URI_DIRECT=mongodb://USER:PASS@ac-1is8sla-shard-00-00.j4zqqkl.mongodb.net:27017,ac-1is8sla-shard-00-01.j4zqqkl.mongodb.net:27017,ac-1is8sla-shard-00-02.j4zqqkl.mongodb.net:27017/test?ssl=true&authSource=admin&retryWrites=true&w=majority

# Comma-separated Discord user IDs to skip inactivity checks (admins are auto-exempt)
EXEMPT_USER_IDS=

# ─────────────────────────────────────────────
#  Optional: FutureRules role ID (if name lookup fails)
# ─────────────────────────────────────────────
# FUTURE_RULES_ROLE_ID=your_role_id_here

# ─────────────────────────────────────────────
#  Main App Database (maindb.js)
#  Stores: employees, intern records (quantum_logics)
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/quantum_logics
