# ─────────────────────────────────────────────
#  Discord Bot
# ─────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_discord_guild_id

# ─────────────────────────────────────────────
#  Activity Bot Database (database.js)
#  Base URI — bot uses test.members for all member data (roles, status, warnings)
#  Also stores: communication, leave logs
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/activity_bot_db

# ─────────────────────────────────────────────
#  Optional: FutureRules role ID (if name lookup fails)
# ─────────────────────────────────────────────
# FUTURE_RULES_ROLE_ID=your_role_id_here

# ─────────────────────────────────────────────
#  Main App Database (maindb.js)
#  Stores: employees, intern records (quantum_logics)
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/quantum_logics
